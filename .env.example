# Environment
NODE_ENV=development

# Server
PORT=12113
HOST=localhost

# CORS
# Comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-anon-key

# Vector database (shared with Specter)
QDRANT_URL=http://127.0.0.1:6333

# Specter integration. In Docker, use /run/secrets/specter_api_token instead.
SPECTER_API_URL=http://127.0.0.1:8000
SPECTER_API_TOKEN_FILE=../../deploy/secrets/api.token
SPECTER_NATS_URL=nats://127.0.0.1:4222
SPECTER_OWNER_ID=facealert


# Authentication Configuration
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_SENDER=no-reply@yourdomain.com

# Testmail Configuration (For E2E Testing)
TESTMAIL_API_KEY=your_testmail_api_key_here
TESTMAIL_NAMESPACE=your_testmail_namespace_here

# Quiet mode for dotenv
DOTENV_CONFIG_QUIET=true